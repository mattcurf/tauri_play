{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tauri Tank Demo",
  "version": "0.1.0",
  "identifier": "com.example.tauri-tank-demo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SCADA Storage Tank — TK-101",
        "width": 920,
        "height": 760,
        "minWidth": 720,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "msi", "nsis"],
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": []
  }
}
